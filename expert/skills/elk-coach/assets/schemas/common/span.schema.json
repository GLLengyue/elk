{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ielts-data.local/schemas/common/span.schema.json",
  "title": "文本片段引用",
  "description": "指向一段文本中的位置。用于 evidence 定位、错误标注、评语引用——评分结果必须能回溯到原文具体位置，否则无法复核。",
  "type": "object",
  "additionalProperties": false,
  "required": ["start", "end"],
  "properties": {
    "start": {
      "type": "integer",
      "minimum": 0,
      "description": "起始偏移（含）"
    },
    "end": {
      "type": "integer",
      "minimum": 0,
      "description": "结束偏移（不含）"
    },
    "unit": {
      "enum": ["char", "word", "sentence", "paragraph"],
      "default": "char",
      "description": "偏移量的计量单位。跨语言文本优先用 char，word 在中文上无定义。"
    },
    "text": {
      "type": "string",
      "description": "片段原文。带上它可以在校验时比对偏移量是否对得上，避免静默漂移。"
    },
    "note": {
      "type": "string",
      "description": "该片段的作用说明，如「照抄题目」「主谓不一致」"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ielts-data.local/schemas/score-result.schema.json",
  "title": "ScoreResult",
  "description": "写作/口语评分输出契约。骨架源自 Shpaldik/OpenIELTS-AI (MIT)，补齐其四处短板：not_official 强制声明、rubric_version（缺失则跨版本回归不可比）、criteria[].matched_anchor（缺失则一致性无保证）、consistency 总分与维度均值交叉校验。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "not_official",
    "rubric_version",
    "model",
    "estimated_band",
    "confidence",
    "summary",
    "criteria",
    "strengths",
    "improvements"
  ],
  "properties": {
    "not_official": {
      "const": true,
      "description": "合规硬约束：AI 估分不是官方成绩，UI 必须展示该声明"
    },
    "rubric_version": {
      "type": "string",
      "description": "如 writing-task2-rubric-v1。rubric/prompt/model 任一变化都会使回归结果不可比，故此字段必填。"
    },
    "prompt_version": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "estimated_band": {
      "type": "number",
      "minimum": 0,
      "maximum": 9,
      "multipleOf": 0.5,
      "description": "multipleOf 0.5 锁死半档步长，OpenIELTS-AI 原版缺失此约束"
    },
    "criteria": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "band",
          "matched_anchor",
          "evidence",
          "feedback",
          "next_step"
        ],
        "properties": {
          "name": {
            "enum": [
              "task_response",
              "task_achievement",
              "coherence_cohesion",
              "lexical_resource",
              "grammatical_range",
              "fluency_coherence",
              "pronunciation"
            ],
            "description": "写作用 TR/CC/LR/GRA；口语用 FC/LR/GRA/P"
          },
          "band": {
            "type": "number",
            "minimum": 0,
            "maximum": 9,
            "multipleOf": 0.5
          },
          "matched_anchor": {
            "type": "string",
            "description": "命中的逐档锚点原文（rubric 里的可观测特征）。缺此项则无法保证评分一致性。"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "quote",
                "occurrence"
              ],
              "properties": {
                "quote": {
                  "type": "string",
                  "description": "必须是学习者原文的精确片段"
                },
                "occurrence": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "第几次出现，用于前端定位高亮"
                }
              }
            }
          },
          "feedback": {
            "type": "string"
          },
          "next_step": {
            "type": "string",
            "description": "一条具体可执行的下一步，而非泛泛建议"
          }
        }
      }
    },
    "consistency": {
      "type": "object",
      "description": "总分与四维均值的交叉校验。OpenIELTS-AI 原版缺失，导致总分与分维度分可能自相矛盾。",
      "properties": {
        "dimension_mean": {
          "type": "number"
        },
        "estimated_band": {
          "type": "number"
        },
        "delta": {
          "type": "number",
          "description": "estimated_band − dimension_mean"
        },
        "reconciled": {
          "type": "boolean",
          "description": "|delta| > 0.5 时必须置 false 并回炉重评"
        }
      }
    },
    "sampling": {
      "type": "object",
      "description": "评分稳定性观测。variance 大的样本说明 rubric 在该维度缺乏判别力，是改进 rubric 的直接信号。",
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 1
        },
        "temperature": {
          "type": "number",
          "minimum": 0
        },
        "band_variance": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "summary": {
      "type": "string"
    },
    "strengths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "improvements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "priority",
          "issue",
          "evidence",
          "action"
        ],
        "properties": {
          "priority": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "issue": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "action": {
            "type": "string"
          }
        }
      }
    },
    "objective_features": {
      "type": "object",
      "description": "仅口语：从音频/转写抽出的客观统计量（WPM、停顿、填充词、TTR）。口语相对写作的结构性优势——有音频就有客观信号，把主观评分拆成客观统计+LLM判断可显著提升一致性。",
      "properties": {
        "word_count": {
          "type": "integer"
        },
        "wpm": {
          "type": "number"
        },
        "mean_pause_s": {
          "type": "number"
        },
        "long_pause_count": {
          "type": "integer",
          "description": "超过 2 秒的停顿次数"
        },
        "filler_rate": {
          "type": "number"
        },
        "type_token_ratio": {
          "type": "number"
        }
      }
    },
    "transcript_note": {
      "type": "string",
      "description": "仅口语：ASR 转写只用于复盘，不直接作为评分输入，否则识别错误会算进语言分"
    },
    "word_count": {
      "type": "integer",
      "description": "仅写作"
    },
    "transcript": {
      "type": "string",
      "description": "被评分的回答转写全文。口语评分的主要输入；写作评分不用此字段（那用 objective_features 里的锚点）。"
    },
    "audio_available": {
      "type": "boolean",
      "description": "是否有原始录音。false 时 pronunciation 必须输出 unavailable——ASR 转写丢弃声学特征，从文本推断发音分数没有信度。"
    },
    "overall_includes_pronunciation": {
      "type": "boolean",
      "description": "overall 是否包含发音维度。音频缺失时为 false，overall 按 FC/LR/GRA 三项均值计算并显式标注。"
    }
  }
}

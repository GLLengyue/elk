{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ielts-data.local/schemas/pack.schema.json",
  "title": "Data Pack Manifest",
  "description": "数据包清单。SKILL 本身不含数据，所有题目由数据包提供；本文件是数据包与加载器之间的契约。",
  "type": "object",
  "additionalProperties": false,
  "required": ["pack_id", "pack_version", "schema_version", "licence", "modules", "contents"],
  "properties": {
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$",
      "description": "数据包唯一标识，与目录名一致"
    },
    "pack_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "数据包自身版本，独立于 SKILL 版本"
    },
    "schema_version": {
      "const": "1.0.0",
      "description": "本清单文件遵循的契约版本"
    },
    "title": {
      "type": "string",
      "description": "人类可读名称"
    },
    "description": {
      "type": "string",
      "description": "数据包内容说明"
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["reading", "writing", "speaking", "listening"]},
      "description": "本数据包覆盖的科目"
    },
    "licence": {
      "$ref": "common/licence.schema.json",
      "description": "数据包自身的许可。付费数据包在此声明限制"
    },
    "redistributable": {
      "type": "boolean",
      "description": "是否允许再分发。付费数据集通常为 false"
    },
    "contents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["counts"],
      "properties": {
        "counts": {
          "type": "object",
          "description": "按科目统计，加载后用于校验完整性",
          "additionalProperties": false,
          "properties": {
            "reading_items": {"type": "integer", "minimum": 0},
            "reading_questions": {"type": "integer", "minimum": 0},
            "speaking_topics": {"type": "integer", "minimum": 0},
            "speaking_questions": {"type": "integer", "minimum": 0},
            "writing_prompts": {"type": "integer", "minimum": 0},
            "writing_essays": {"type": "integer", "minimum": 0}
          }
        },
        "seasons": {
          "type": "array",
          "items": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "description": "口语题库覆盖的考季"
        },
        "source_types": {
          "type": "array",
          "items": {"enum": ["official_sample", "synthetic", "licensed", "third_party"]},
          "description": "数据来源类型，便于按合规等级筛选"
        }
      }
    },
    "sources": {
      "type": "array",
      "description": "数据来源清单（URL / 抓取日期 / 许可），对应 SOURCES.md",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["origin"],
        "properties": {
          "origin": {"type": "string"},
          "source_url": {"type": "string"},
          "retrieved_at": {"type": "string"},
          "licence": {"type": "string"},
          "note": {"type": "string"}
        }
      }
    },
    "checksum": {
      "type": "string",
      "description": "可选的完整性校验值，格式 sha256:<hex>。加载器会在可用时校验 data/ 下文件"
    },
    "notes": {
      "type": "string",
      "description": "给使用者看的注意事项，例如使用范围限制"
    }
  }
}
